<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_payment_method_redsys_form" model="ir.ui.view">
        <field name="name">pos.payment.method.redsys.form</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet" position="inside">
                <group string="Redsys TPV-PC" invisible="not redsys_enabled">
                    <group string="Conexión">
                        <field name="redsys_proxy_url" placeholder="http://10.0.1.21:8765"/>
                        <field name="redsys_comercio" placeholder="369559141"/>
                        <field name="redsys_terminal" placeholder="1"/>
                        <field name="redsys_com_port" placeholder="COM9:,19200,N,8,1"/>
                        <field name="redsys_timeout"/>
                    </group>
                    <group string="Credenciales Redsys">
                        <field name="redsys_usuario" placeholder="3695591412100"/>
                        <field name="redsys_password" password="True"/>
                    </group>
                    <group string="Estado">
                        <field name="redsys_proxy_status" readonly="1"/>
                        <button name="action_test_redsys_proxy" type="object" string="Probar conexión" class="btn-secondary"/>
                        <button name="action_download_redsys_proxy" type="object" string="Descargar Proxy Windows" class="btn-primary"/>
                    </group>
                </group>
                <group string="Habilitar Redsys TPV-PC">
                    <field name="redsys_enabled"/>
                    <field name="use_payment_terminal" invisible="not redsys_enabled" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
