<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_payment_method_redsys_form" model="ir.ui.view">
        <field name="name">pos.payment.method.redsys.form</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_payment_method_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='use_payment_terminal']" position="after">
                <div invisible="use_payment_terminal != 'redsys_tpvpc'" class="o_setting_box">
                    <div class="o_setting_left_pane">
                        <field name="redsys_enabled" widget="boolean_toggle"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="redsys_enabled" string="Redsys TPV-PC"/>
                        <div class="text-muted">Datáfono Verifone P400 via TpvpcWinService</div>
                        <div invisible="not redsys_enabled" class="mt-2">
                            <div class="row">
                                <div class="col-6">
                                    <field name="redsys_proxy_url" placeholder="http://10.0.1.50:8765"/>
                                </div>
                                <div class="col-3">
                                    <field name="redsys_comercio" placeholder="369559141"/>
                                </div>
                                <div class="col-3">
                                    <field name="redsys_terminal" placeholder="1"/>
                                </div>
                            </div>
                            <div class="row mt-2">
                                <div class="col-3">
                                    <field name="redsys_timeout"/>
                                </div>
                                <div class="col-3">
                                    <field name="redsys_proxy_status" readonly="1"/>
                                </div>
                            </div>
                            <div class="mt-3 d-flex gap-2">
                                <button name="action_test_redsys_proxy"
                                        type="object"
                                        string="Probar conexión"
                                        class="btn btn-secondary btn-sm"/>
                                <button name="action_download_redsys_proxy"
                                        type="object"
                                        string="⬇ Descargar Proxy Windows"
                                        class="btn btn-primary btn-sm"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
